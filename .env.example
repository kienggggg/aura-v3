# AURA v3 — biến môi trường. Chép thành `.env` rồi điền.
#
# v3 CHỈ đọc biến bắt đầu bằng AURA_CHAT_. Không có core/config.py 1.029 dòng,
# không có cờ bật/tắt tính năng. Danh sách dưới đây đọc ra từ chính mã
# (interface/chat_adapters.py và interface/chat_app.py), không phải chép tay.
#
# Mọi giá trị dưới đây đều là MẪU. Không dán khoá thật vào tệp này — nó được
# theo dõi bởi git. Khoá thật đi vào `.env`, và `.env` đã nằm trong .gitignore.

# ─── Cửa vào ───
AURA_CHAT_HOST=127.0.0.1
AURA_CHAT_PORT=8799

# ─── Model local (Ollama) — trò làm trước ───
AURA_CHAT_LOCAL_ENABLED=1
AURA_CHAT_LOCAL_HOST=http://localhost:11434
AURA_CHAT_LOCAL_MODEL=qwen3.5:4b

# ─── Cổng cloud — thầy, chỉ mượn khi trò bí ───
# Bỏ trống cả ba thì AURA vẫn chạy: UnavailableModelGateway giữ cửa trước sống,
# trả lời là "chưa cấu hình cổng cloud" thay vì đổ.
AURA_CHAT_BASE_URL=
AURA_CHAT_MODEL=
AURA_CHAT_API_KEY=

# ─── Khác ───
AURA_CHAT_TIMEOUT_S=90
# Bỏ trống thì mặc định là <gốc dự án>/data/chat_sessions
AURA_CHAT_TRANSCRIPT_ROOT=
